# =============================================================================
# ResolveHub Frontend Environment Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# Application Meta
VITE_APP_NAME="ResolveHub"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="development"

VITE_API_BASE_URL="http:[IP_ADDRESS]01/api/v1"
VITE_WS_URL="ws[IP_ADDRESS]001/ws/dashboard"
VITE_API_TIMEOUT=15000

# Feature Flags
VITE_ENABLE_MOCK_DATA="false"

# Operational Defaults
VITE_DEFAULT_PAGE_SIZE=6
VITE_AUTO_REFRESH_INTERVAL=30000

